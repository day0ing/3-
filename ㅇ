def crawl_university_housing():
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        "Accept-Language": "ko-KR,ko;q=0.9"
    }
    
    scraped_items = []
    id_counter = 1

    print("=== 실제 웹 크롤링 프로세스 시작 ===")

    for uni in UNIVERSITIES:
        uni_name = uni["university"]
        district = uni["district"]
        dong = uni["dong"]
        
        target_url = f"https://m.land.naver.com/search?query={district}+{dong}"
        
        try:
            response = requests.get(target_url, headers=headers, timeout=5)
            if response.status_code == 200:
                soup = BeautifulSoup(response.text, 'html.parser')
         
                
                print(f"[{uni_name}] {district} {dong} 연결 성공 (상태 코드: 200)")
            else:
                print(f"[{uni_name}] 접근 차단 또는 응답 오류 (코드: {response.status_code})")
                
        except Exception as e:
            print(f"[{uni_name}] 크롤링 중 예외 발생: {e}")

    print("=== 크롤링 완료 및 데이터 반영 ===")

